<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and lower. -->
<full-backup-content>
    <!-- Crashlytics' persisted collection override beats the manifest flag; a restored one could re-enable collection. -->
    <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
</full-backup-content>
