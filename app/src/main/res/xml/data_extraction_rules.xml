<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+; keep in sync with backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.firebase.crashlytics.xml" />
    </device-transfer>
</data-extraction-rules>
